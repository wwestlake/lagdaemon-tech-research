// Every value chosen to be exactly representable and exactly computed
// in float, no rounding ambiguity:
//   clamp(10, 0, 5) = min(max(10,0),5) = min(10,5) = 5.0
//   lerp(0, 10, 0.5) = 0 + (10-0)*0.5 = 5.0
//   min(10, 4) = 4.0, max(10, 4) = 10.0
// Total: 5.0 + 5.0 + 4.0 + 10.0 = 24.0.
func main() -> float {
    var x: float = 10.0;
    var y: float = 4.0;
    return clamp(x, 0.0, 5.0) + lerp(0.0, 10.0, 0.5) + min(x, y) + max(x, y);
}
