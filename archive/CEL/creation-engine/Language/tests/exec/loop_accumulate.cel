// Sum of squares 1..5 -- hand-computed: 1+4+9+16+25 = 55. Exercises a
// C-style for loop (init/cond/step) with a compound-assign accumulator.
func SumOfSquares(n: int) -> int {
    var total: int = 0;
    for (var i: int = 1; i <= n; i += 1) {
        total += i * i;
    }
    return total;
}

func main() -> int {
    return SumOfSquares(5);
}
