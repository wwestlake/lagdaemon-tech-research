// Every value chosen to be exactly representable and exactly computed
// in float. b is diagonal(1,2,3) specifically so its transpose is
// trivially itself (a real, if simple, transpose-correctness check) and
// its square is diagonal(1,4,9) (matrix multiply, not componentwise).
//
//   b * v where v=(1,1,1) -> bv = (1,2,3) (diagonal scales each axis)
//   b*b (real matrix multiply) = diagonal(1,4,9) -> column 2 = (0,0,9)
//   2.0*b*v = (2,4,6)
//   -identity, column 1 = (0,-1,0)
//   (b+identity)*v = diagonal(2,3,4)*v = (2,3,4)
// Subtotal: (1+2+3) + 9 + (2+4+6) + (-1) + (2+3+4) = 35
// Plus the equality-branch bonus (100.0) since transpose3(b) == b.
// Total: 135.
func main() -> float {
    var ident: mat3 = mat3_identity();
    var b: mat3 = mat3_from_columns(vec3(1.0, 0.0, 0.0), vec3(0.0, 2.0, 0.0), vec3(0.0, 0.0, 3.0));
    var v: vec3 = vec3(1.0, 1.0, 1.0);
    var bv: vec3 = b * v;
    var bb: mat3 = b * b;
    var bb_col2: vec3 = bb * vec3(0.0, 0.0, 1.0);
    var scaled: mat3 = 2.0 * b;
    var scaled_v: vec3 = scaled * v;
    var neg: mat3 = -ident;
    var neg_col1: vec3 = neg * vec3(0.0, 1.0, 0.0);
    var sum_m: mat3 = b + ident;
    var sum_v: vec3 = sum_m * v;
    var total: float = bv.x + bv.y + bv.z + bb_col2.z + scaled_v.x + scaled_v.y + scaled_v.z + neg_col1.y +
                        sum_v.x + sum_v.y + sum_v.z;
    if (transpose3(b) == b) {
        total += 100.0;
    }
    return total;
}
