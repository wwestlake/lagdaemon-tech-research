// Hand-computed, every term exact in float (no rounding ambiguity):
//   length(v1) = sqrt(1^2+2^2+2^2) = sqrt(9) = 3.0
//   dot(v1, v2) = 1*0 + 2*1 + 2*0 = 2.0
//   cross((1,0,0), (0,1,0)).z = 1*1 - 0*0 = 1.0
// Total: 3.0 + 2.0 + 1.0 = 6.0. Exercises vec3 construction, dot,
// cross, length, and member access together.
func main() -> float {
    var v1: vec3 = vec3(1.0, 2.0, 2.0);
    var v2: vec3 = vec3(0.0, 1.0, 0.0);
    var a: vec3 = vec3(1.0, 0.0, 0.0);
    var b: vec3 = vec3(0.0, 1.0, 0.0);
    var c: vec3 = cross(a, b);
    return length(v1) + dot(v1, v2) + c.z;
}
