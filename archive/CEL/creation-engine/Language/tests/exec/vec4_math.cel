// Every value chosen to be exactly representable and exactly computed
// in float -- v1 has a single nonzero component so normalize4(v1)
// lands on an exact (0,0,0,1.0) rather than a non-power-of-2 fraction:
//   length4(v1) = sqrt(4^2) = 4.0
//   dot4(v1, v2) = 0 (no overlapping nonzero component) = 0.0
//   v3 = v1 + v2 = (1,0,0,4) -> v3.w = 4.0
//   v4 = v1 * 2.0 = (0,0,0,8) -> v4.w = 8.0
//   normalize4(v1) = (0,0,0,4)/4.0 = (0,0,0,1.0) -> n.w = 1.0
//   neg = -v2 = (-1,0,0,0) -> neg.x = -1.0
// Subtotal: 4.0 + 0.0 + 4.0 + 8.0 + 1.0 - 1.0 = 16.0
// Plus the equality-branch bonus (100.0) since v2 == vec4(1,0,0,0).
// Total: 116.0. Exercises vec4 construction, +, scalar *, dot4,
// length4, normalize4, unary -, member access (.w), and == together.
func main() -> float {
    var v1: vec4 = vec4(0.0, 0.0, 0.0, 4.0);
    var v2: vec4 = vec4(1.0, 0.0, 0.0, 0.0);
    var v3: vec4 = v1 + v2;
    var v4: vec4 = v1 * 2.0;
    var n: vec4 = normalize4(v1);
    var neg: vec4 = -v2;
    var total: float = length4(v1) + dot4(v1, v2) + v3.w + v4.w + n.w + neg.x;
    if (v2 == vec4(1.0, 0.0, 0.0, 0.0)) {
        total += 100.0;
    }
    return total;
}
