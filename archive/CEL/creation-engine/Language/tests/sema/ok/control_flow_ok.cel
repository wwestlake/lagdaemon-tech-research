func Classify(x: int) -> int {
    if (x > 10) {
        return 2;
    } else {
        if (x > 0) {
            return 1;
        } else {
            return 0;
        }
    }
}

func Sum(n: int) -> int {
    var total: int = 0;
    var i: int = 0;
    while (i < n) {
        if (i == 3) {
            i += 1;
            continue;
        }
        total += i;
        i += 1;
    }

    for (var j: int = 0; j < n; j += 1) {
        if (j == n - 1) {
            break;
        }
        total += 1;
    }

    return total;
}

func NoReturnValue() {
    log("no return needed");
}
