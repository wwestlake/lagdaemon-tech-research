// Deliberately never terminates on its own -- sema's return-on-all-paths
// analysis is conservative about every loop regardless of its condition
// (see early_return.cel's comment), so `return x;` after the loop is
// still required for this to type-check even though control can never
// actually reach it. The watchdog (ce_watchdog_tick, called once per
// loop iteration) is the only thing that stops this from hanging
// forever; ScriptContext::loopBudget's default (10,000,000) bounds how
// long that takes.
func main() -> int {
    var x: int = 0;
    while (true) {
        x += 1;
    }
    return x;
}
