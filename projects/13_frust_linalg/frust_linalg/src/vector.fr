struct Vec2f {
    x: f32,
    y: f32
}

struct Vec3f {
    x: f32,
    y: f32,
    z: f32
}

struct Vec4f {
    x: f32,
    y: f32,
    z: f32,
    w: f32
}

pub fn vec2f(x: f32, y: f32) -> Vec2f = {
    Vec2f { x: x, y: y }
}

pub fn vec3f(x: f32, y: f32, z: f32) -> Vec3f = {
    Vec3f { x: x, y: y, z: z }
}

pub fn vec4f(x: f32, y: f32, z: f32, w: f32) -> Vec4f = {
    Vec4f { x: x, y: y, z: z, w: w }
}

pub fn vec2f_zero() -> Vec2f = {
    vec2f(0.0, 0.0)
}

pub fn vec3f_zero() -> Vec3f = {
    vec3f(0.0, 0.0, 0.0)
}

pub fn vec4f_zero() -> Vec4f = {
    vec4f(0.0, 0.0, 0.0, 0.0)
}

pub fn vec2f_add(a: Vec2f, b: Vec2f) -> Vec2f = {
    vec2f(a.x + b.x, a.y + b.y)
}

pub fn vec3f_add(a: Vec3f, b: Vec3f) -> Vec3f = {
    vec3f(a.x + b.x, a.y + b.y, a.z + b.z)
}

pub fn vec4f_add(a: Vec4f, b: Vec4f) -> Vec4f = {
    vec4f(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w)
}

pub fn vec2f_sub(a: Vec2f, b: Vec2f) -> Vec2f = {
    vec2f(a.x - b.x, a.y - b.y)
}

pub fn vec3f_sub(a: Vec3f, b: Vec3f) -> Vec3f = {
    vec3f(a.x - b.x, a.y - b.y, a.z - b.z)
}

pub fn vec4f_sub(a: Vec4f, b: Vec4f) -> Vec4f = {
    vec4f(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w)
}

pub fn vec2f_scale(v: Vec2f, s: f32) -> Vec2f = {
    vec2f(v.x * s, v.y * s)
}

pub fn vec3f_scale(v: Vec3f, s: f32) -> Vec3f = {
    vec3f(v.x * s, v.y * s, v.z * s)
}

pub fn vec4f_scale(v: Vec4f, s: f32) -> Vec4f = {
    vec4f(v.x * s, v.y * s, v.z * s, v.w * s)
}

pub fn vec2f_dot(a: Vec2f, b: Vec2f) -> f32 = {
    a.x * b.x + a.y * b.y
}

pub fn vec3f_dot(a: Vec3f, b: Vec3f) -> f32 = {
    a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn vec4f_dot(a: Vec4f, b: Vec4f) -> f32 = {
    a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
}

pub fn vec3f_cross(a: Vec3f, b: Vec3f) -> Vec3f = {
    vec3f(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    )
}

pub fn vec2f_length_sq(v: Vec2f) -> f32 = {
    vec2f_dot(v, v)
}

pub fn vec3f_length_sq(v: Vec3f) -> f32 = {
    vec3f_dot(v, v)
}

pub fn vec4f_length_sq(v: Vec4f) -> f32 = {
    vec4f_dot(v, v)
}

pub fn vec3f_distance_sq(a: Vec3f, b: Vec3f) -> f32 = {
    vec3f_length_sq(vec3f_sub(a, b))
}

pub fn vec3f_lerp(a: Vec3f, b: Vec3f, t: f32) -> Vec3f = {
    vec3f(
        lerp_f32(a.x, b.x, t),
        lerp_f32(a.y, b.y, t),
        lerp_f32(a.z, b.z, t)
    )
}

pub fn vec3f_clamp(v: Vec3f, lo: Vec3f, hi: Vec3f) -> Vec3f = {
    vec3f(
        clamp_f32(v.x, lo.x, hi.x),
        clamp_f32(v.y, lo.y, hi.y),
        clamp_f32(v.z, lo.z, hi.z)
    )
}
