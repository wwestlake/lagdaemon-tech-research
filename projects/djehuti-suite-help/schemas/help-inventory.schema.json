{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djehuti.example/schemas/help-inventory.schema.json",
  "title": "DjehutiSuite application help inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "buildVersion",
    "sourceRevision",
    "generatedAt",
    "items"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0" },
    "product": { "type": "string", "minLength": 1 },
    "buildVersion": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "helpId",
        "kind",
        "label",
        "owner",
        "documentation",
        "behaviorSignature",
        "sourceRef"
      ],
      "properties": {
        "helpId": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": ["application", "view", "control", "command", "workflow", "setting", "error"]
        },
        "label": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "documentation": { "enum": ["required", "recommended", "none"] },
        "documentationReason": { "type": "string", "minLength": 1 },
        "behaviorSignature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceRef": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "uiPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "since": { "type": "string", "minLength": 1 },
        "deprecated": { "type": "boolean", "default": false },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "documentation": { "const": "none" } },
            "required": ["documentation"]
          },
          "then": { "required": ["documentationReason"] }
        }
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    }
  }
}
